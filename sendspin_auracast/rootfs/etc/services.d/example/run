#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the example service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

# Add your code here

# Declare variables
declare url
declare transport
declare message

## Get the 'message' key from the user config options.
music_assistant_url=$(bashio::config 'music_assistant_url')
transport=$(bashio::config 'transport')
extra_args=$(bashio::config 'extra_args')
name=$(bashio::config 'name')
initial_volume=$(bashio::config 'initial_volume')

# Start the service with the provided configuration
exec sendspin-auracast ${music_assistant_url} \
    --transport ${transport} \
    --name "${name}" \
    --initial-volume ${initial_volume} \
    ${extra_args}
